# 服务器配置
PORT=3001
NODE_ENV=development

# JWT配置
JWT_SECRET=guagua_secret_key_2025_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=123456
DB_NAME=guagua
DB_PORT=3306

# API配置
API_BASE_URL=http://localhost:3001

# 上传配置
UPLOAD_MAX_SIZE=50mb
# 图片上传策略
IMAGE_UPLOAD_STRATEGY=oss
# 视频上传策略
VIDEO_UPLOAD_STRATEGY=local

# 本地存储配置
LOCAL_UPLOAD_DIR=uploads
LOCAL_BASE_URL=http://localhost:3001
# 视频存储目录
VIDEO_UPLOAD_DIR=uploads/videos
# 视频封面存储目录
VIDEO_COVER_DIR=uploads/covers

# Cloudflare R2 配置（当IMAGE_UPLOAD_STRATEGY=r2或VIDEO_UPLOAD_STRATEGY=r2时使用）
# 请从 Cloudflare 控制台获取您自己的配置信息
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name_here
R2_ACCOUNT_ID=your_account_id_here
R2_REGION=auto
# 可选：如果有自定义域名，可以设置 R2_PUBLIC_URL
# R2_PUBLIC_URL=https://your-custom-domain.com

# 注意：
# 1. R2_ACCOUNT_ID 需要从 Cloudflare 控制台获取
# 2. R2_BUCKET_NAME 需要先在 Cloudflare R2 中创建存储桶
# 3. 如果使用自定义域名，需要在 Cloudflare 中配置域名绑定
# 4. 请不要将真实的密钥提交到版本控制系统中

# 阿里云 OSS 配置（当 IMAGE_UPLOAD_STRATEGY=oss 或 VIDEO_UPLOAD_STRATEGY=oss 时使用）
# 请从阿里云 OSS 控制台获取您自己的配置信息
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
OSS_BUCKET=your_bucket_name_here
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 可选：自定义 CDN 域名（如配置了阿里云 CDN 加速）
# OSS_CUSTOM_DOMAIN=https://your-cdn-domain.example.com

# 注意：
# 1. OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET 在 RAM 访问控制中创建 AccessKey 获取
# 2. OSS_BUCKET 需要先在阿里云 OSS 中创建 Bucket，并设置公共读权限
# 3. OSS_REGION 与 OSS_ENDPOINT 必须与 Bucket 所在区域一致
# 4. 配置 OSS_CUSTOM_DOMAIN 可加速国内访问（需在阿里云 CDN 控制台配置）
# 5. 请不要将真实的密钥提交到版本控制系统中

# CORS配置
CORS_ORIGIN=http://localhost:5173

# 支付宝支付配置（电脑网站支付）
# 开启后，商城订单才支持支付宝在线支付
ALIPAY_ENABLED=false
# 是否使用沙箱环境（true=沙箱调试，false=线上正式）
ALIPAY_SANDBOX=true
# 开放平台应用 APPID（沙箱环境下使用沙箱应用的 APPID）
ALIPAY_APP_ID=your_alipay_app_id_here
# 应用私钥（在开放平台生成密钥对后填写，注意换行用 \n 或直接使用 env 文件多行）
ALIPAY_PRIVATE_KEY=your_rsa2_private_key_here
# 支付宝公钥（在开放平台「应用公钥」上传后，用支付宝提供的公钥）
ALIPAY_PUBLIC_KEY=your_alipay_public_key_here
# 异步通知地址：支付宝服务器会 POST 到这个地址，必须是公网可访问（本地开发可用内网穿透）
ALIPAY_NOTIFY_URL=http://localhost:3001/api/alipay/notify
# 同步跳转地址：用户支付完成后浏览器跳转到这里
ALIPAY_RETURN_URL=http://localhost:3001/api/alipay/return
# 前端地址（用于支付结果页跳转回商城订单页）
FRONTEND_BASE_URL=http://localhost:5173