# AI 服务配置（复制为 .env 并填写真实值）

# ── LLM 对话模型──────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

LLM_CANDIDATES=
LLM_FAILURE_THRESHOLD=2
LLM_OPEN_DURATION_MS=30000
LLM_FIRST_PACKET_TIMEOUT_MS=8000
LLM_INVOKE_TIMEOUT_MS=30000

# ── Embedding 模型─────────────────────────
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3

# ── 数据库──────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guagua
DB_USER=root
DB_PASSWORD=your_local_mysql_password

# ── 服务配置 ──────────────────────────────────────────────────
AI_SERVICE_PORT=8085
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

AI_PERSIST_CONVERSATION=python

# ── Redis 连接 ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ── 限流配置 ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_CONCURRENT=10
RATE_LIMIT_MAX_WAIT_SECONDS=15

# ── 多路检索配置 ──────────────────────────────────────────────
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_RECALL_BUDGET=20
RETRIEVAL_RERANK_CANDIDATE_LIMIT=40
RETRIEVAL_RRF_K=20
RETRIEVAL_CHANNEL_WEIGHTS={"vector":1.0,"keyword":1.0,"hot":0.5}
RETRIEVAL_ENABLE_KEYWORD=true
RETRIEVAL_ENABLE_HOT=true